# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.
# Keep this file in sync whenever a new env var is introduced (CLAUDE.md section 3).

# --- Supabase ---
# Local dev: `npx supabase start` prints the URL and anon key.
# Cloud: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS — never expose to the client,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site ---
# The deployed origin, with no trailing slash. Printed into every canonical
# URL, Open Graph tag, sitemap entry and robots.txt (Phase 8), so a wrong value
# here is visible to search engines rather than to users. Public by definition.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# --- Google Maps Platform ---
# Browser key: Maps JS API and Places Autocomplete. Restrict it by HTTP
# referrer in the Google Cloud Console — it is visible to anyone who loads a
# page.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server key: Geocoding (address -> the point stored in jobs.location).
# Restrict it by IP instead; a referrer-restricted key does not work from a
# server. Falls back to the browser key above when unset.
GOOGLE_MAPS_SERVER_API_KEY=

# Set to 1 to accept running with no Maps key at all: addresses are typed by
# hand and placed against the built-in city gazetteer in lib/maps/geocode.ts,
# which is approximate on purpose. Development already behaves this way; this
# flag is what makes it acceptable in a production build instead of an error.
ALLOW_NO_MAPS_KEY=

# --- Twilio (SMS OTP) ---
# Read by the Supabase CLI when it starts the local auth container, and by the
# hosted project's Auth settings. Never read by application code.
#
# Local development does not need any of these: supabase/config.toml maps the
# demo phone numbers to fixed OTP codes under [auth.sms.test_otp]. See README,
# "Signing in locally".
#
# The account SID and messaging service SID are not secrets and live in
# supabase/config.toml (an explicit value there takes precedence over the
# environment). The auth token is a secret and only ever comes from here.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Operational scripts (never read by the app) ---
# Optional. Points scripts/purge-bypass-users.mjs at a database other than the
# local stack — the hosted project, when the time comes to clear the bypass
# accounts there. Unset, the script talks to the local Supabase container.
DATABASE_URL=

# --- OTP bypass (real SMS delivery stood down) ---
# Set to 1 to stop sending anything at all and let a fixed code sign in ANY
# phone number. See lib/auth/bypass.ts for why this exists: Twilio charges
# $0.2575 per SMS to Israel, WhatsApp is not free either and needs a registered
# business, so until there is one this product delivers nothing.
#
# With this on, anybody who reaches the sign-in screen can create an account
# and post real rows. The six digits are decoration, not a check. It cannot
# reach the seeded users (they have no password) and it cannot mint an admin
# (handle_new_user whitelists the role), but it is otherwise wide open.
#
# NOT NEXT_PUBLIC_, on purpose: unlike NEXT_PUBLIC_DEMO_LOGINS below, this is
# read on the server and never reaches a browser bundle. It still needs a
# REDEPLOY to change anything — a Vercel deployment is immutable, so editing
# this in the dashboard leaves the running site exactly as it was.
AUTH_BYPASS_OTP=

# The password every bypass account is created with and signed in through. Any
# non-empty value; it is a real credential for as long as the flag above is on,
# so treat it like one and do not commit it. Required when AUTH_BYPASS_OTP=1 —
# the sign-in refuses loudly rather than failing obscurely without it.
AUTH_BYPASS_PASSWORD=

# --- Demo logins (out-of-band demo tooling, not a product feature) ---
# Set to 1 to put a "quick demo login" panel on the landing page: four buttons
# that sign straight in as the seeded users from supabase/seed.sql, including
# the admin. It exists so the product can be shown without typing a phone
# number and a code at every step.
#
# Leave this UNSET anywhere a stranger can reach. The seeded numbers and the
# fixed 123456 are live credentials on the deployed site (CLAUDE.md section 9);
# without the flag they still work but have to be guessed, and with it the
# landing page hands them over — including the button that reaches /admin. The
# safe posture is to set it on a Vercel Preview deployment and demo from that
# URL, leaving the indexed production alias without it.
#
# NEXT_PUBLIC_ means this is inlined at build time: unsetting it in the Vercel
# dashboard changes nothing until the next deploy. There is no runtime switch.
NEXT_PUBLIC_DEMO_LOGINS=
