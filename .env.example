# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.
# Keep this file in sync whenever a new env var is introduced (CLAUDE.md section 3).

# --- Supabase ---
# Local dev: `npx supabase start` prints the URL and anon key.
# Cloud: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS — never expose to the client,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform ---
# Maps JS API, Places Autocomplete, Geocoding, Distance Matrix.
# Restrict this key by HTTP referrer in the Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Twilio (SMS OTP) ---
# Configured inside Supabase Auth → Phone provider, not read by app code.
# Listed here so the required credentials are documented in one place.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
